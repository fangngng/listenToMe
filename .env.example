# ===== ASR 语音转写（OpenAI 兼容接口）=====
# 默认使用硅基流动 https://cloud.siliconflow.cn （SenseVoice 免费档，注册送额度）
# 任何 OpenAI 兼容的 /audio/transcriptions 服务都可以：SiliconFlow / Groq / OpenAI 等
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=sk-你的硅基流动Key
ASR_MODEL=FunAudioLLM/SenseVoice-V1.8

# ===== LLM 点评（DeepSeek）=====
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 服务端口 =====
PORT=3000
