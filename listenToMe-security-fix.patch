 docs/nginx.conf   |   7 ++
 package-lock.json | 136 +++++++++--------------------------
 package.json      |   2 +-
 public/app.js     |  72 ++++++++++++++++---
 public/index.html |   2 +-
 server.js         | 179 +++++++++++++++++++++++++++++++++++++++-------
 test-auth.mjs     | 105 +++++++++++++++++++++++++++
 7 files changed, 363 insertions(+), 140 deletions(-)
 create mode 100644 test-auth.mjs

diff --git a/docs/nginx.conf b/docs/nginx.conf
index c1d4ac4..bb3e95b 100644
--- a/docs/nginx.conf
+++ b/docs/nginx.conf
@@ -61,6 +61,13 @@ http {
             proxy_send_timeout 300s;
         }
 
+        # 入口 JS 不长时间缓存：发版后老用户应立即拿到新版（其他静态资源仍长缓存）
+        location ~* /app\.js$ {
+            expires 1h;
+            add_header Cache-Control "public, must-revalidate";
+            try_files $uri =404;
+        }
+
         # 处理静态资源
         location ~* \.(ico|css|js|gif|jpe?g|png|webp|svg)$ {
             expires 365d;
