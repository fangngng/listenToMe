+for (let i = 0; i < 75; i++) {
+  try { await fetch(`${base}/api/accounts?group=`); break } catch { await new Promise(r => setTimeout(r, 200)) }
+  if (i === 74) { console.error('服务启动超时'); srv.kill(); process.exit(1) }
+}
+const results = []
