+r = await fetch(`${base}/api/accounts/${accId}`, { headers: { 'X-Account-Secret': 'b'.repeat(32) } })
+check('GET 错误密钥被拒 403', r.status === 403)
+
+// 5. 正确密钥读取 -> ok
+r = await fetch(`${base}/api/accounts/${accId}`, { headers: { 'X-Account-Secret': secret } })
